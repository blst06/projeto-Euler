# URL base da API (backend no Render)
# Em desenvolvimento: deixe vazio — o proxy do Vite redireciona /api → localhost:3000
# Em produção (Vercel): configure com a URL do Render
# Exemplo: https://cartivore-backend.onrender.com
VITE_API_BASE=
