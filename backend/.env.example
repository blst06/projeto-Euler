# ──────────────────────────────────────────────────────────────────────────────
# Cartivore — Backend | Variáveis de Ambiente
# Copie para .env e ajuste antes de rodar
# ──────────────────────────────────────────────────────────────────────────────

# Ambiente
NODE_ENV=development

# Porta do servidor (Render injeta PORT automaticamente em produção)
PORT=3000

# JWT Secret — OBRIGATÓRIO mudar em produção! Use uma string longa e aleatória.
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cartivore-change-this-in-production-secret-key

# URL do frontend (para liberar CORS em produção)
# Exemplo: https://cartivore.vercel.app
FRONTEND_URL=http://localhost:5173

# Caminho do banco SQLite
# Em produção no Render com disco persistente, use o caminho do disco montado:
# DB_PATH=/var/data/cartivore.db
DB_PATH=cartivore.db
