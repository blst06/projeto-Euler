# ──────────────────────────────────────────────────────────────────────────────
# Cartivore v1.0 — Variáveis de Ambiente
# Copie este arquivo para .env e configure suas credenciais
# ──────────────────────────────────────────────────────────────────────────────

# Ambiente
NODE_ENV=development

# Porta do servidor (Render usa PORT automaticamente)
PORT=3000

# JWT Secret — ALTERE em produção! Use uma string longa e aleatória
JWT_SECRET=cartivore-change-this-in-production-secret-key

# URL do frontend (para CORS em produção no Render)
# Exemplo: https://cartivore.vercel.app
FRONTEND_URL=http://localhost:5173
